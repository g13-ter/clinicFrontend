# Copy this file to .env for local overrides, or set these in your
# hosting platform's environment variables UI (Vercel/Netlify/etc.) before
# building for production. Never commit the actual .env file.

# Base URL of the deployed backend API, including the "/api" prefix.
# Leave unset for local development — Vite's dev server proxy (vite.config.ts)
# already forwards "/api" to http://localhost:5000.
# Required in production (frontend and backend are separate services/domains):
# VITE_API_URL=https://clinic-backend.up.railway.app/api